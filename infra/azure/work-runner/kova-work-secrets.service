[Unit]
Description=Kova Work managed identity secret initialization
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/kova-work/ACTIVATED

[Service]
Type=oneshot
User=root
UMask=0077
RuntimeDirectory=kova-work
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /usr/local/lib/kova-work/load-secrets.py
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/kova-work
StandardOutput=null

