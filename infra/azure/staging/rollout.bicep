targetScope = 'resourceGroup'

@description('Explicit opt-in. Default false emits no resource mutation. This is not the staging bootstrap template.')
param enableRevisionRollout bool = false

@description('Complete private writable Container App resource generated by revision-rollout-plan.mjs after preservation and healthy-previous checks. Never supply a partial configuration or publish these parameters.')
@secure()
param rolloutResource object

// Only the separately approved existing staging app; no environment, role,
// registry, secret store, receiver or production resource is created here.
resource stagingCandidate 'Microsoft.App/containerApps@2025-01-01' = if (enableRevisionRollout && toLower(resourceGroup().id) == '/subscriptions/ab732127-11c3-46a7-a1cb-6ee8d86594f4/resourcegroups/rg-kovagpt-staging') {
  name: 'ca-kovagpt-staging'
  location: rolloutResource.location
  tags: rolloutResource.tags
  identity: rolloutResource.identity
  properties: rolloutResource.properties
}
