# Supabase (server and browser-safe publishable values)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# AI provider credentials are server-only. Production should prefer Azure
# OpenAI with Container Apps managed identity or an Azure API key. OPENAI_API_KEY
# is retained only as an explicit direct-provider rollback path.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=

# Keep disabled until migrations, mock smoke tests, and one owner-authorized live test pass.
AI_GENERATION_ENABLED=false
# Catalog-validated model IDs; see src/lib/ai/model-catalog.server.ts.
KOVA_INSTANT_MODEL=gpt-5.6-luna
KOVA_NORMAL_MODEL=gpt-5.6-luna
KOVA_THINKING_MODEL=gpt-5.6-terra
KOVA_DEEP_MODEL=gpt-5.6-sol
KOVA_UTILITY_MODEL=gpt-5.6-luna

# Model routing is centralized in src/lib/ai/model-config.mjs.
KOVA_MODEL_DEFAULT_CHAT=gpt-5.6-luna
KOVA_MODEL_ADVANCED_REASONING=gpt-5.6-terra
KOVA_MODEL_PREMIUM_REASONING=gpt-5.6-sol
KOVA_MODEL_UTILITY=gpt-5.6-luna
KOVA_MODEL_IMAGE_ANALYSIS=gpt-5.6-luna
KOVA_MODEL_IMAGE_GENERATION=gpt-image-1
KOVA_MODEL_EMBEDDING=text-embedding-3-small
KOVA_CHAT_MODEL=gpt-5.6-luna
KOVA_FAST_MODEL=gpt-5.6-luna
KOVA_IMAGE_MODEL=gpt-image-1
KOVA_EMBEDDING_MODEL=text-embedding-3-small
KOVA_AI_TIMEOUT_MS=45000
KOVA_MAX_COST_USD_PER_REQUEST=0.10
KOVA_MAX_TOKENS_PER_USER_DAY=50000
KOVA_MAX_TOKENS_PER_USER_MONTH=500000
KOVA_MAX_PREMIUM_REQUESTS_PERIOD=50
KOVA_MAX_GUEST_REQUESTS_PER_IP=5
KOVA_MAX_CONCURRENT_GLOBAL=10
KOVA_MAX_CONCURRENT_PER_USER=2
KOVA_MAX_CONCURRENT_PER_GUEST=1
KOVA_GENERATION_LEASE_SECONDS=120
KOVA_IP_HASH_SECRET=
KOVA_AI_CAPABILITIES=

# Search / research
FIRECRAWL_API_KEY=
KOVA_SEARCH_TIMEOUT_MS=15000

# Stripe billing
# Browser-safe publishable key for the approved KovaGPT live account
# acct_1UAeDgAEZlsb6DBY. It must match the account behind STRIPE_LIVE_API_KEY.
VITE_PAYMENTS_CLIENT_TOKEN=
# Operator-verified account provenance for readiness; must equal the approved ID above.
STRIPE_LIVE_ACCOUNT_ID=
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
# Existing live config bpc_1UB2ZxAEZlsb6DBYU3PoJJPU must be owner-approved,
# wired, and verified. It supports payment methods, invoices, customer details,
# and cancellation; subscription plan changes are disabled.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Google connectors
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

CONNECTOR_TOKEN_ENCRYPTION_KEY=
CONNECTOR_ENCRYPTION_KEY=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=
BOX_OAUTH_CLIENT_ID=
BOX_OAUTH_CLIENT_SECRET=

# Read-only financial aggregation
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
KOVA_FINANCE_REGIONS=US
FINANCE_WEBHOOK_VERIFICATION_TOKEN=

# Isolated browser worker
AGENT_WORKER_ID=

# GitHub OAuth and GitHub App
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=

# Email
EMAIL_PREVIEW_TOKEN=
KOVA_EMAIL_QUEUE_ENABLED=false
RESEND_API_KEY=
EMAIL_API_KEY=

# Azure Container Apps deployment
AZURE_ENVIRONMENT=development
# Required only when AZURE_ENVIRONMENT=production. Configure one Cloudflare
# per-hostname AOP client-certificate SHA-256 fingerprint, or two comma-separated
# fingerprints only during a zero-downtime rotation. This value is not secret.
KOVA_CLOUDFLARE_CLIENT_CERT_SHA256_FINGERPRINTS=
AZURE_FOUNDRY_ENDPOINT=
# Exact resource origin, for example https://resource.openai.azure.com.
AZURE_OPENAI_ENDPOINT=
# Legacy API-version setting retained for migration tooling; the v1 runtime does not require it.
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_DEPLOYMENT_CHAT=kova-chat
AZURE_OPENAI_DEPLOYMENT_THINKING=kova-think
AZURE_OPENAI_DEPLOYMENT_DEEP=kova-deep
AZURE_OPENAI_DEPLOYMENT_IMAGE=
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=
# Optional user-assigned managed identity client ID. IDENTITY_ENDPOINT and
# IDENTITY_HEADER are injected by Azure Container Apps and must not be set manually.
AZURE_CLIENT_ID=
PORT=3000
HOST=0.0.0.0
# Stripe uses account-matched values supplied by the deployment operator.
# Pass this public key as a Docker build argument; setting it at runtime alone
# cannot configure the compiled browser checkout. Never place a secret key here.
# Keep disabled until migrations, old-writer drain, policy decisions and smoke pass.
STRIPE_BILLING_RUNTIME=disabled

# Durable same-chat summaries. Keep disabled until the migration, privacy checks,
# provider budget, and authenticated worker schedule are verified by the owner.
KOVA_CHAT_SUMMARIES_ENABLED=false
CHAT_SUMMARY_WORKER_SECRET=
# Optional workspace semantics; keyword search requires only the source migration.
KOVA_WORKSPACE_SEMANTIC_ENABLED=false
WORKSPACE_SEARCH_WORKER_SECRET=
# Trusted contacts remain off until eligibility, regional, consent and retention policy approval.
KOVA_TRUSTED_CONTACTS_ENABLED=false
KOVA_TRUSTED_CONTACTS_POLICY_VERSION=

# Developer ledger activation requires approved expiring prices, funded accounts and scope limits.
# This does not enable a public API or alter consumer plan accounting.
KOVA_DEVELOPER_BILLING_ENABLED=false
DEVELOPER_BILLING_WORKER_SECRET=
KOVA_DEVELOPER_API_ENABLED=false
# Developer MCP OAuth is source-only until issuer/provider/billing activation is reviewed.
KOVA_MCP_OAUTH_ENABLED=false
KOVA_MCP_DYNAMIC_REGISTRATION_ENABLED=false
KOVA_MCP_ISSUER=
# Independent 32+ character secret-manager value; rotating it invalidates developer keys and quotes.
DEVELOPER_KEY_PEPPER=
# No approved offers, purchase calls or payment activation are created by source setup.
KOVA_DEVELOPER_PAYMENTS_ENABLED=false
KOVA_DEVELOPER_FILES_ENABLED=false
DEVELOPER_PAYMENTS_ENV=
DEVELOPER_PAYMENTS_ORIGIN=
DEVELOPER_PAYMENTS_WEBHOOK_SECRET=
DEVELOPER_FUNDING_WORKER_SECRET=

# Web Push stays off until VAPID, the encryption key and the private worker are activated.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_WORKER_SECRET=
# Isolated interactive Work browser: source remains disabled until owner setup.
KOVA_WORK_BROWSER_ENABLED=false
KOVA_WORK_BROWSER_IMAGE=
KOVA_WORK_BROWSER_ORIGINS_JSON=[]
# Organization SCIM endpoints are disabled until operator activation.
# Each owner must separately issue a 90-day tenant token for its verified SSO provider.
KOVA_ORGANIZATION_SCIM_ENABLED=false
