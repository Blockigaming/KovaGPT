# Supabase (server and browser-safe publishable values)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Direct AI provider. Keys are server-side only; do not prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
KOVA_CHAT_MODEL=gpt-4o-mini
KOVA_FAST_MODEL=gpt-4o-mini
KOVA_DEEP_MODEL=gpt-4o
KOVA_IMAGE_MODEL=gpt-image-1
KOVA_EMBEDDING_MODEL=text-embedding-3-small
KOVA_AI_TIMEOUT_MS=45000
# Comma-separated optional capability override. Leave blank for provider defaults.
KOVA_AI_CAPABILITIES=

# Search / research
FIRECRAWL_API_KEY=
KOVA_SEARCH_TIMEOUT_MS=15000

# Stripe billing
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# Connector OAuth. Secrets are server-side only. Callback URLs use
# /api/integrations/oauth/callback/{provider} unless the provider is Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CONNECTOR_TOKEN_ENCRYPTION_KEY=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=
BOX_OAUTH_CLIENT_ID=
BOX_OAUTH_CLIENT_SECRET=

# Read-only financial aggregation. Keep disabled until Plaid approval and credentials exist.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
KOVA_FINANCE_REGIONS=US
FINANCE_WEBHOOK_VERIFICATION_TOKEN=

# Isolated browser worker. Never expose these values to Vite/client code.
AGENT_WORKER_ID=

# Optional email preview route guard
EMAIL_PREVIEW_TOKEN=
# Set to true only when an external queue worker is actively processing transactional_emails.
KOVA_EMAIL_QUEUE_ENABLED=false
