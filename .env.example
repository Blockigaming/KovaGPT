# Supabase (server and browser-safe publishable values)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Direct AI provider. Keys are server-side only; do not prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
KOVA_CHAT_MODEL=gpt-4o-mini
KOVA_FAST_MODEL=gpt-4o-mini
KOVA_DEEP_MODEL=gpt-4o
KOVA_IMAGE_MODEL=gpt-image-1
KOVA_EMBEDDING_MODEL=text-embedding-3-small
KOVA_AI_TIMEOUT_MS=45000
# Comma-separated optional capability override. Leave blank for provider defaults.
KOVA_AI_CAPABILITIES=

# Search / research
FIRECRAWL_API_KEY=
KOVA_SEARCH_TIMEOUT_MS=15000

# Stripe billing
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# Google connectors
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub OAuth and GitHub App (server-side only)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=

# Optional email preview route guard
EMAIL_PREVIEW_TOKEN=
# Set to true only when an external queue worker is actively processing transactional_emails.
KOVA_EMAIL_QUEUE_ENABLED=false

CONNECTOR_ENCRYPTION_KEY=
