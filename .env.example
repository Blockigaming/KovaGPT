# Supabase (server and browser-safe publishable values)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Direct OpenAI runtime. Every value in this section is server-only.
OPENAI_API_KEY=

# Keep disabled until migrations, mock smoke tests, and one owner-authorized live test pass.
AI_GENERATION_ENABLED=false
# Catalog-validated OpenAI model IDs; see src/lib/ai/model-catalog.server.ts.
KOVA_INSTANT_MODEL=gpt-4.1-nano
KOVA_NORMAL_MODEL=gpt-4.1-mini
KOVA_THINKING_MODEL=gpt-5-mini
KOVA_DEEP_MODEL=gpt-5
KOVA_UTILITY_MODEL=gpt-4.1-nano

# Model routing is centralized in src/lib/ai/model-config.mjs. Override a
# logical role here to migrate models without touching application logic.
KOVA_MODEL_DEFAULT_CHAT=gpt-5.6-luna
KOVA_MODEL_ADVANCED_REASONING=gpt-5.6-terra
KOVA_MODEL_PREMIUM_REASONING=gpt-5.6-sol
KOVA_MODEL_UTILITY=gpt-5.6-luna
KOVA_MODEL_IMAGE_ANALYSIS=gpt-5.6-luna
KOVA_MODEL_IMAGE_GENERATION=gpt-image-1
KOVA_MODEL_EMBEDDING=text-embedding-3-small
# Legacy adapter knobs (optional, superseded by the role variables above).
KOVA_CHAT_MODEL=gpt-5.6-luna
KOVA_FAST_MODEL=gpt-5.6-luna
KOVA_DEEP_MODEL=gpt-5.6-sol

KOVA_IMAGE_MODEL=gpt-image-1
KOVA_EMBEDDING_MODEL=text-embedding-3-small
# Provider timeout in milliseconds.
KOVA_AI_TIMEOUT_MS=45000
# USD estimated preflight ceiling.
KOVA_MAX_COST_USD_PER_REQUEST=0.10
# Billable tokens per UTC day.
KOVA_MAX_TOKENS_PER_USER_DAY=50000
# Billable tokens per UTC calendar month.
KOVA_MAX_TOKENS_PER_USER_MONTH=500000
# Thinking and Deep combined per authoritative billing period.
KOVA_MAX_PREMIUM_REQUESTS_PERIOD=50
# Accepted guest requests per keyed IP hash per UTC day.
KOVA_MAX_GUEST_REQUESTS_PER_IP=5
# Distributed active generation leases globally.
KOVA_MAX_CONCURRENT_GLOBAL=10
# Distributed active leases per authenticated user.
KOVA_MAX_CONCURRENT_PER_USER=2
# Distributed active leases per guest IP hash.
KOVA_MAX_CONCURRENT_PER_GUEST=1
# Stale-lease timeout in seconds.
KOVA_GENERATION_LEASE_SECONDS=120
# Generate at least 32 random bytes; server-only and distinct from all other secrets.
KOVA_IP_HASH_SECRET=
# Comma-separated optional capability override. Leave blank for provider defaults.
KOVA_AI_CAPABILITIES=

# Search / research
FIRECRAWL_API_KEY=
KOVA_SEARCH_TIMEOUT_MS=15000

# Stripe billing
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# Connector OAuth. Secrets are server-side only.

# Google connectors
# Must exactly match an authorized redirect URI in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Additional connector OAuth. Callback URLs use
# /api/integrations/oauth/callback/{provider}.
CONNECTOR_TOKEN_ENCRYPTION_KEY=
CONNECTOR_ENCRYPTION_KEY=

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=

NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=

DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=

BOX_OAUTH_CLIENT_ID=
BOX_OAUTH_CLIENT_SECRET=

# Read-only financial aggregation.
# Keep disabled until Plaid approval and credentials exist.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
KOVA_FINANCE_REGIONS=US
FINANCE_WEBHOOK_VERIFICATION_TOKEN=

# Isolated browser worker.
# Never expose these values to Vite/client code.
AGENT_WORKER_ID=

# GitHub OAuth and GitHub App (server-side only)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=

# Optional email preview route guard
EMAIL_PREVIEW_TOKEN=
# Set to true only when an external queue worker is actively processing transactional_emails.
KOVA_EMAIL_QUEUE_ENABLED=false
# Configure one direct provider for the queue processor. RESEND_API_KEY uses the Resend API;
# KOVA_EMAIL_SEND_URL can point at an internal provider webhook and optionally use KOVA_EMAIL_SEND_TOKEN.
RESEND_API_KEY=
KOVA_EMAIL_SEND_URL=
KOVA_EMAIL_SEND_TOKEN=
