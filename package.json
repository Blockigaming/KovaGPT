{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run release:zero-lovable:built",
    "build:dev": "vite build --mode development && npm run release:zero-lovable:built",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test --config=playwright.browser.config.ts",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:a11y": "node --test tests/a11y/*.test.mjs",
    "test:visual": "node --test tests/visual/*.test.mjs && KOVA_BROWSER_PREVIEW=node playwright test tests/e2e/ui-quality.spec.ts --project=phone-390x844 --project=tablet-1024x768 --project=desktop-1440x900",
    "test:ui-parity": "playwright test tests/e2e/chatgpt-parity.spec.ts --project=desktop-1280x800",
    "test:ui-parity:shell": "playwright test tests/e2e/chatgpt-shell-parity.spec.ts --config=playwright.release.config.ts",
    "smoke:deployment": "node scripts/post-deploy-smoke.mjs",
    "audit:ui-parity": "node scripts/ui-parity-audit.mjs",
    "format:check:changed": "node scripts/check-format-changed.mjs",
    "worker:dev": "node --watch worker/src/index.mjs",
    "worker:start": "node worker/src/index.mjs",
    "worker:health": "node worker/scripts/health-check.mjs",
    "worker:smoke": "node worker/scripts/smoke-test.mjs",
    "db:migrate": "node scripts/release/supabase-db-push.mjs",
    "release:migrations": "node scripts/release/migrations.mjs --check",
    "release:manifest": "node scripts/release/migrations.mjs --write",
    "release:migration-preflight": "node scripts/release/migration-preflight.mjs --source-only",
    "release:migration-preflight:ready": "node scripts/release/migration-preflight.mjs --ready",
    "release:rls:two-user:dry": "node scripts/release/rls-two-user.mjs --dry-run",
    "release:rls:two-user": "node scripts/release/rls-two-user.mjs --execute",
    "release:zero-lovable": "node scripts/release/zero-lovable.mjs",
    "release:zero-lovable:strict": "node scripts/release/zero-lovable.mjs --strict-lock",
    "release:zero-lovable:built": "node scripts/release/zero-lovable.mjs --strict-lock --require-build",
    "release:auth-provider": "node scripts/release/auth-provider-contract.mjs",
    "release:auth-provider:strict": "node scripts/release/auth-provider-contract.mjs --strict-lock",
    "release:chatgpt-parity-source": "node scripts/release/apply-chatgpt-parity-source.mjs --check",
    "release:security-source": "node scripts/release/apply-security-source.mjs --check",
    "release:ui-truthfulness": "node scripts/release/ui-truthfulness.mjs",
    "release:visible-controls": "node scripts/release/visible-control-contract.mjs",
    "release:stripe:contract": "node scripts/release/stripe-test-path.mjs",
    "release:ai-provider-contract": "node scripts/release/ai-provider-contract.mjs",
    "release:rollback:check": "node scripts/release/rollback-evidence.mjs",
    "release:env": "node scripts/release/environment.mjs",
    "release:bundle": "node scripts/release/bundle-budget.mjs",
    "release:security": "node scripts/release/security.mjs",
    "release:smoke": "node scripts/release/smoke.mjs --dry-run",
    "release:local": "node scripts/release/local-non-actions-gate.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "release:validate": "npm run release:migrations && npm run release:migration-preflight && npm run release:schema && npm run release:db:references && npm run release:env && npm run test:release && npm run release:security-source && npm run release:chatgpt-parity-source && npm run release:security && npm run release:ui-truthfulness && npm run release:visible-controls && npm run release:zero-lovable && npm run release:auth-provider && npm run release:stripe:contract && npm run release:ai-provider-contract && npm run release:tanstack && npm run release:edge && npm run release:bundle",
    "release:schema": "node scripts/release/schema-contract.mjs",
    "release:db:isolated": "node scripts/release/isolated-database.mjs",
    "release:db:dry": "node scripts/release/isolated-database.mjs --dry-run",
    "release:edge": "node scripts/release/edge-contract.mjs",
    "release:tanstack": "node scripts/release/tanstack-family.mjs",
    "release:candidate": "node scripts/release/release-candidate.mjs",
    "release:smoke:authenticated": "node scripts/release/authenticated-smoke.mjs --dry-run",
    "test:e2e:shard": "playwright test --reporter=blob",
    "release:db:references": "node scripts/release/database-references.mjs",
    "release:launch-report": "node scripts/release/launch-report.mjs",
    "release:production-guard": "node scripts/release/production-guard.mjs && npm run release:zero-lovable:strict && npm run release:auth-provider:strict && npm run release:migration-preflight:ready && npm run release:stripe:contract && npm run release:ai-provider-contract && npm run release:rollback:check",
    "release:visual:authenticated": "node scripts/release/visual-harness.mjs --dry-run",
    "security:ai-runtime": "node scripts/security/scan-ai-runtime.mjs",
    "container:build": "docker build -t kovagpt-web:azure-dev .",
    "container:run": "docker run --rm --name kovagpt-web-azure-dev --env-file .env.local -e KOVA_GENERATION_DISABLED=true -e HOST=0.0.0.0 -e PORT=3000 -p 3000:3000 kovagpt-web:azure-dev",
    "container:smoke": "node -e \"fetch('http://127.0.0.1:3000/api/health').then(async r=>{console.log(r.status, await r.text()); process.exit(r.ok?0:1)}).catch(e=>{console.error(e); process.exit(1)})\"",
    "azure:validate": "node scripts/azure/validate.mjs",
    "azure:staging:validate": "node scripts/azure/validate-staging-template.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
